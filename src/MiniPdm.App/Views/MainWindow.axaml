<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MiniPdm.App.Localization"
        xmlns:vm="using:MiniPdm.App.ViewModels"
        x:Class="MiniPdm.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Localize Key=App_Title}"
        Width="1200" Height="760" MinWidth="980" MinHeight="600"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Window.Resources>
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#D9E5FB" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#CFDDFA" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#C5D5F8" />
        <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#1F1F1F" />
        <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#1F1F1F" />
        <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#1F1F1F" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <Style Selector="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C9C9C9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6,14,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8E9EB" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="BorderBrush" Value="#E3E3E3" />
            <Setter Property="Foreground" Value="#A6A6A6" />
        </Style>
        
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#9DBCF7" />
            <Setter Property="Foreground" Value="#F4F6FB" />
        </Style>
        
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9C9C9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6,10,6" />
        </Style>

        <Style Selector="TextBox.cardField">
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <Style Selector="TextBox.hint">
            <Setter Property="Foreground" Value="#757575" />
        </Style>
        
        <Style Selector="TextBox.searchBox">
            <Setter Property="Width" Value="380" />
        </Style>


        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9C9C9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6,8,6" />
        </Style>
        
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TreeViewItem:selected">
            <Setter Property="Background" Value="#D9E5FB" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="TreeViewItem:selected:pointerover">
            <Setter Property="Background" Value="#CFDDFA" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="TreeViewItem:selected:pressed">
            <Setter Property="Background" Value="#C5D5F8" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6E6E6" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECECEC" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9,12,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="SeparatorBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="#ECECEC" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="DataGridCell:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F4F7FE" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#DCE7FB" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="DataGridRow:selected:pointerover">
            <Setter Property="Background" Value="#DCE7FB" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Border#DGR_Border">
            <Setter Property="Background" Value="#DCE7FB" />
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*,Auto">
        
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E6E6E6" BorderThickness="0,0,0,1"
                Padding="12,10,12,10">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Button Classes="accent" Grid.Column="0" Content="{loc:Localize Key=Import_Folder}"
                        Command="{Binding ImportFolderCommand}" MinWidth="140" />
                <Button Grid.Column="1" Content="{loc:Localize Key=Calc_Mass}"
                        Command="{Binding CalcMassCommand}" Margin="10,0,0,0" MinWidth="160" />
                <Button Grid.Column="2" Content="{loc:Localize Key=Calc_Summary}"
                        Command="{Binding CalcSummaryCommand}" Margin="10,0,0,0" MinWidth="180" />
                
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="0,0,16,0"
                            IsVisible="{Binding IsImporting}">
                    <ProgressBar Width="200" Height="6"
                                 Value="{Binding ProgressValue}" Maximum="100"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" />
                    <Button Content="{loc:Localize Key=Import_Cancel}"
                            Command="{Binding CancelImportCommand}" />
                </StackPanel>
                
                <TextBox Grid.Column="5" Classes="searchBox"
                         Text="{Binding SearchText}"
                         IsVisible="{Binding !IsImporting}"
                         Watermark="{loc:Localize Key=Search_Watermark}">
                    <TextBox.InnerLeftContent>
                        <Border Width="32">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="16" Height="16"
                                  Data="M2,7.5 A5.5,5.5 0 1,0 13,7.5 A5.5,5.5 0 1,0 2,7.5 M11.8,11.8 L15,15"
                                  Stroke="#757575" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Border>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </Border>


        <Grid Grid.Row="1" ColumnDefinitions="1.1*,Auto,1.8*">
            
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="12,14,8,12">
                <TextBlock Grid.Row="0" Classes="panelTitle" Margin="4,0,0,10"
                           Text="{loc:Localize Key=Left_Panel_Title}" />
                <TextBlock Grid.Row="1" Text="{loc:Localize Key=Tree_Empty}"
                           Foreground="#757575" Margin="4,4,0,0"
                           IsVisible="{Binding HasNoRoots}" />
                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding SelectedNode}"
                          IsVisible="{Binding !HasNoRoots}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Display}" />
                                <TextBlock Text="{Binding QuantityText}" Foreground="#8A8A8A" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" Background="#E4E4E4" />
            
            <ScrollViewer Grid.Column="2">
                <StackPanel IsVisible="{Binding Card.HasSelection}" Margin="18,14,12,16">
                    <TextBlock Classes="h1" Text="{Binding Card.Card.Name}" />
                    <TextBlock Classes="subtitle" Text="{Binding Card.Subtitle}" />

                    <Grid ColumnDefinitions="195,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <!-- Обозначение -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_Designation}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="cardField"
                                 Text="{Binding Card.Card.Designation}" Margin="0,0,0,8" />

                        <!-- Наименование -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_Name}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="cardField"
                                 Text="{Binding Card.Card.Name}" Margin="0,0,0,8" />

                        <!-- Тип -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_Type}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="cardField"
                                 Text="{Binding Card.TypeDisplay}" Margin="0,0,0,8" />

                        <!-- Версия -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_Version}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Classes="cardField"
                                 Text="{Binding Card.Card.Version, Mode=OneWay, FallbackValue=''}"
                                 Margin="0,0,0,8" />

                        <!-- Масса, кг -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_Mass}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Classes="cardField hint"
                                 Text="{Binding Card.MassDisplay}" Margin="0,0,0,8" />

                        <!-- Состояние -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="label"
                                   Text="{loc:Localize Key=Card_Label_State}" />

                        <WrapPanel Grid.Row="5" Grid.Column="1">
                            <ComboBox MinWidth="230" Margin="0,0,10,10"
                                      ItemsSource="{Binding Card.StateOptions}"
                                      SelectedItem="{Binding Card.SelectedStateOption, Mode=TwoWay}" />
                            <Button Classes="accent" Content="{loc:Localize Key=State_Approve}"
                                    Command="{Binding Card.ApproveCommand}" MinWidth="130" Margin="0,0,10,10"
                                    IsVisible="{Binding Card.CanApprove}" />
                            <Button Content="{loc:Localize Key=State_Annull}"
                                    Command="{Binding Card.AnnulCommand}" MinWidth="130" Margin="0,0,0,10"
                                    IsVisible="{Binding Card.CanAnnul}" />
                        </WrapPanel>
                    </Grid>

                    <StackPanel IsVisible="{Binding Card.HasComposition}" Margin="0,18,0,0">
                        <TextBlock Classes="panelTitle" Margin="0,0,0,10"
                                   Text="{loc:Localize Key=Card_Composition_Title}" />
                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{Binding Card.Composition}"
                                  MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Localize Key=Summary_Column_Designation}"
                                                    Binding="{Binding Designation}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="{loc:Localize Key=Summary_Column_Name}"
                                                    Binding="{Binding Name}" Width="1.1*" MinWidth="160" />
                                <DataGridTextColumn Header="{loc:Localize Key=Summary_Column_Quantity}"
                                                    Binding="{Binding Quantity}" Width="0.5*" MinWidth="70" />
                                <DataGridTextColumn Header="{loc:Localize Key=Summary_Column_UnitMass}"
                                                    Binding="{Binding UnitMass}" Width="0.7*" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <Border Grid.Row="2" Background="#F5F5F5"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="14,7,14,7">
            <WrapPanel>
                <TextBlock Margin="0,0,28,0" Text="{Binding StatusDbText}" FontSize="12"
                           Foreground="#B3261E"
                           IsVisible="{Binding StatusDbText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Margin="0,0,28,0" Text="{Binding StatusServerText}" FontSize="12" Foreground="#5F5F5F" />
                <TextBlock Margin="0,0,28,0" Text="{Binding StatusObjectsText}" FontSize="12" Foreground="#5F5F5F" />
                <TextBlock Margin="0" Text="{Binding StatusImportText}" FontSize="12" Foreground="#5F5F5F" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
